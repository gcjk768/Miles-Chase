# Copy to .env (never commit .env) and fill in.
TELEGRAM_BOT_TOKEN=123456789:ABCdef...
TELEGRAM_CHAT_ID=-1001234567890
# Optional:
# sections = each report section is its own message, only the first one notifies (default);
# off = one long message.
# SPLIT_MESSAGES=sections
# Quiet days (no fare changes or deals): line = one short message (default),
# silent = nothing, off = always post the full daily report.
# DAILY_QUIET=line
# CLAUDE_MODEL=
# Full path to claude, needed under cron. Find it with: which claude
# CLAUDE_BIN=/usr/local/bin/claude
