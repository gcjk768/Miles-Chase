# Copy to .env (never commit .env) and fill in.
TELEGRAM_BOT_TOKEN=123456789:ABCdef...
TELEGRAM_CHAT_ID=-1001234567890
# Optional:
# Hourly watch, 24/7: new posts/videos from the miles blogs and YouTube channels, plus new
# KrisFlyer partner promos and KrisShop brand discounts. Claude (haiku, JUDGE_MODELS) is only
# asked when something is new, and only what matters to you is posted. on or off, and how often.
# NEWS_ALERTS=on
# NEWS_EVERY_MINUTES=60
# Brands watched on KrisShop (and in KrisFlyer promos). Comma-separated; unset = DEFAULT_BRANDS in
# promo_watch.py (Garmin, Dyson, Apple, Shokz, Sony, Samsung, Bose, JBL, DJI and ~20 more).
# PROMO_BRANDS=Garmin, Dyson, Apple, Shokz, Sony
# KrisShop deals in any category: the most popular items of each category at this % off or more.
# CATEGORY_MIN_OFF=25
# Let Claude fix broken data files after a failed job: on or off.
# SELF_REPAIR=on
# sections = each report section is its own message, only the first one notifies (default);
# off = one long message.
# SPLIT_MESSAGES=sections
# Quiet days (no fare changes or deals): line = one short message (default),
# silent = nothing, off = always post the full daily report.
# DAILY_QUIET=line
# Obsidian vault (movement log + memory, see vault.py). Unset = no vault.
# On the NAS docker-compose.yml mounts /volume1/James/Obsidian/Miles Chase at /vault.
# VAULT_DIR=/vault
CLAUDE_MODEL=haiku
JUDGE_MODELS=haiku
# Full path to claude, needed under cron. Find it with: which claude
# CLAUDE_BIN=/usr/local/bin/claude
